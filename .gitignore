# ── Entorno Virtual ───────────────────────────────────────────
venv/
.venv/
env/

# ── Variables de entorno (NUNCA versionar) ────────────────────
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/
notebooks/
*.ipynb

# ── Data (no se versiona) ─────────────────────────────────────
/data/
*.csv
*.parquet
*.pkl
*.h5
*.xlsx
*.dump

# ── Modelos V1 y V2 (no se usan en Railway) ──────────────────
models/
models_v2/

# ── Modelos V3: solo los champion.joblib van a Railway (~11MB) ─
models_v3/**/*.joblib
!models_v3/**/champion.joblib

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log

# ── IDE ───────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Claude ────────────────────────────────────────────────────
.claude/

# ── Google Sheets credentials (NUNCA versionar) ───────────────
secrets/

# ── Scripts de prueba / notas locales (no versionar) ─────────
.cursorrules
scripts/manual/4G
scripts/manual/check_yfinance_download_v2*.py

# Backups locales de la migracion FT (descartables)
scripts/migrations/backup_ft_local_*/

# Reportes HTML generados (artefactos, no versionar)
reportes/

# Salida del modulo scripts/reports/ (YAMLs, MDs, PDFs, PNGs por analisis)
scripts/reports/output/

# Salida del dashboard (JPG exportados del informe por ticker)
dashboard/output/

# Artefactos generados en examples/ (solo se versiona el YAML de input)
scripts/reports/examples/*.pdf
scripts/reports/examples/*.png
